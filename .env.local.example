# Copy this file to `.env.local` and fill in your values. `.env.local` is git-ignored.

# ── OpenAI (required for real AI analysis, chat, and transcription) ───────────
# Get a key at https://platform.openai.com/api-keys (use your hackathon credits).
OPENAI_API_KEY=sk-...

# Optional — chat/analysis model. Defaults to gpt-4o-mini (fast, cheap, JSON mode).
# OPENAI_MODEL=gpt-4o-mini

# Optional — speech-to-text model for /api/transcribe (call recordings).
# Defaults to gpt-4o-mini-transcribe; set to whisper-1 for classic Whisper.
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe


# ── Real in-app calls via Twilio (optional) ──────────────────────────────────
# Leave these unset to use Sentinel's built-in simulated call flow.
# When set, "Call Parent" dials the parent's phone (managed in Settings) while
# YOU talk through the app in the browser — no phone needed for you. The call is
# recorded and OpenAI transcribes it afterwards.
#
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token          # used to download the recording
# TWILIO_PHONE_NUMBER=+14155550100           # your Twilio number (caller ID), E.164
#
# For browser (WebRTC) calling — create an API Key and a TwiML App in the console:
#   Console → Account → API keys & tokens → Create API key (Standard)
#   Console → Voice → TwiML → TwiML Apps → Create; set its Voice URL to
#     {PUBLIC_BASE_URL}/api/call/voice   (POST)
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=your_api_key_secret
# TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Public https origin Twilio can reach for webhooks (recording + TwiML). In dev:
#   ngrok http 3000
# then paste the https URL here (no trailing slash), e.g.
PUBLIC_BASE_URL=https://ab12cd34.ngrok-free.app

# Opt out of Next.js anonymous telemetry
NEXT_TELEMETRY_DISABLED=1

